<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Single theme — colors switch via values/colors.xml vs values-night/colors.xml -->
    <style name="Theme.DharmaPath" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dim</item>
        <item name="colorOnPrimary">@color/bg_base</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_elevated</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
