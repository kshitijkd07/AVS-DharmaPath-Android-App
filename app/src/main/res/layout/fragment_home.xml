<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- HomeHeader: Sun glyph + title + date + bell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- Sun glyph -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="☀"
                android:textSize="22sp"
                android:gravity="center"
                android:textColor="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dharma Path"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_greeting_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bell button -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">
                <TextView
                    android:id="@+id/btn_bell"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="🔔"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/bg_card" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dot_amber" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Profile card (home-glass-card) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_elevated"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Avatar with gold ring -->
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">
                        <ImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_avatar_ring"
                            android:scaleType="centerCrop"
                            android:contentDescription="Profile" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Namaste"
                            android:textColor="@color/purple_accent"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_user_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Begin Jaap button -->
                    <TextView
                        android:id="@+id/btn_begin_jaap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Begin Jaap ›"
                        android:textColor="@color/bg_base"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_pill_accent"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stats row (home-glass-card with dividers) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_elevated"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center" android:paddingTop="16dp" android:paddingBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📈" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Streak" android:textColor="@color/text_muted" android:textSize="10sp"
                            android:textAllCaps="true" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/tv_streak_val" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Days" android:textColor="@color/text_muted" android:textSize="10sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center" android:paddingTop="16dp" android:paddingBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🎯" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total Jaap" android:textColor="@color/text_muted" android:textSize="10sp"
                            android:textAllCaps="true" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/tv_total_jaap_val" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="0"
                            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mantras" android:textColor="@color/text_muted" android:textSize="10sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center" android:paddingTop="16dp" android:paddingBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📅" android:textSize="18sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tithi" android:textColor="@color/text_muted" android:textSize="10sp"
                            android:textAllCaps="true" android:layout_marginTop="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ekadashi" android:textColor="@color/text_primary" android:textSize="14sp"
                            android:textStyle="bold" android:layout_marginTop="2dp" android:gravity="center" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Shukla Paksha" android:textColor="@color/text_muted" android:textSize="9sp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Panchang card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_elevated"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Today's Panchang"
                            android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <View android:layout_width="6dp" android:layout_height="6dp"
                            android:background="@drawable/bg_dot_amber" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" LIVE" android:textColor="@color/accent" android:textSize="10sp"
                            android:textStyle="bold" android:textAllCaps="true" />
                    </LinearLayout>

                    <!-- Tithi + Moon row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="TITHI" android:textColor="@color/text_muted" android:textSize="10sp"
                                android:textAllCaps="true" android:letterSpacing="0.1" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Shukla Paksha Ekadashi" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:layout_marginTop="2dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="NAKSHATRA" android:textColor="@color/text_muted" android:textSize="10sp"
                                android:textAllCaps="true" android:layout_marginTop="10dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Rohini" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:layout_marginTop="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="☀ 06:14 AM" android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="  🌙 06:28 PM" android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <!-- Moon illustration -->
                        <TextView android:layout_width="100dp" android:layout_height="100dp"
                            android:text="🌙" android:textSize="52sp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Muhurat rows -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:background="@drawable/bg_muhurat_green"
                        android:padding="12dp" android:gravity="center_vertical" android:layout_marginTop="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="☀ Abhijit Muhurat" android:textColor="@color/text_primary"
                                android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="11:58 AM – 12:46 PM ›" android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:background="@drawable/bg_muhurat_rose"
                        android:padding="12dp" android:gravity="center_vertical" android:layout_marginTop="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="⭐ Rahu Kaal" android:textColor="@color/text_primary"
                                android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="04:30 PM – 06:00 PM ›" android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Action Orbs row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout android:id="@+id/orb_mantra" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="60dp" android:layout_height="60dp"
                        android:layout_gravity="center">
                        <View android:layout_width="60dp" android:layout_height="60dp"
                            android:background="@drawable/bg_orb_purple" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:text="🌸" android:textSize="24sp" android:gravity="center" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mantra Library" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:gravity="center" android:layout_marginTop="6dp"
                        android:layout_gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/orb_puja" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="60dp" android:layout_height="60dp"
                        android:layout_gravity="center">
                        <View android:layout_width="60dp" android:layout_height="60dp"
                            android:background="@drawable/bg_orb_gold" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:text="🔥" android:textSize="24sp" android:gravity="center" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Daily Puja" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:gravity="center" android:layout_marginTop="6dp"
                        android:layout_gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/orb_calendar" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="60dp" android:layout_height="60dp"
                        android:layout_gravity="center">
                        <View android:layout_width="60dp" android:layout_height="60dp"
                            android:background="@drawable/bg_orb_blue" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:text="📅" android:textSize="24sp" android:gravity="center" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Calendar" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:gravity="center" android:layout_marginTop="6dp"
                        android:layout_gravity="center" />
                </LinearLayout>

                <LinearLayout android:id="@+id/orb_astro" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <FrameLayout android:layout_width="60dp" android:layout_height="60dp"
                        android:layout_gravity="center">
                        <View android:layout_width="60dp" android:layout_height="60dp"
                            android:background="@drawable/bg_orb_pink" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:text="✨" android:textSize="24sp" android:gravity="center" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Astro Insights" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:gravity="center" android:layout_marginTop="6dp"
                        android:layout_gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
