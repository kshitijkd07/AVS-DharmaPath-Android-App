<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_elevated"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Top row: text + flame icon -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_puja_category"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/accent" android:textSize="10sp"
                    android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.1" />
                <TextView android:id="@+id/tv_puja_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_primary" android:textSize="18sp"
                    android:textStyle="bold" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tv_puja_deity"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_muted" android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
            <!-- Flame icon box -->
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                <View android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_circle_accent" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:text="🔥" android:textSize="20sp" android:gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border" android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Bottom row: duration + rating + verified -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_puja_duration"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_muted" android:textSize="12sp" />
            <View android:layout_width="4dp" android:layout_height="4dp"
                android:background="@drawable/bg_dot_green"
                android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tv_puja_rating"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/star_yellow" android:textSize="12sp" />
            <TextView android:id="@+id/tv_puja_verified"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Verified"
                android:textColor="@color/green_accent" android:textSize="12sp"
                android:gravity="end" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
